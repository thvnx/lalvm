@LIT_SITE_CFG_IN_HEADER@

import sys

config.lalvm_tools_dir = "@LLVM_RUNTIME_OUTPUT_INTDIR@"
config.llvm_tools_dir = "@LLVM_TOOLS_BINARY_DIR@"
config.lalvm_obj_root = "@CMAKE_CURRENT_BINARY_DIR@"
config.lalvm_build_root = "@CMAKE_BINARY_DIR@"
