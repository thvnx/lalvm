{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {
        "LIBADALANG_DIR": "/path/to/libadalang/build/or/install/dir",
        "MLIR_DIR": "/usr/lib/llvm-21/lib/cmake/mlir",
        "CMAKE_C_COMPILER": "clang-21",
        "CMAKE_CXX_COMPILER": "clang++-21"
      }
    },
    {
      "name": "release",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "",
        "LLVM_ENABLE_ASSERTIONS": "OFF"
      }
    },
    {
      "name": "coverage",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build-cov",
      "cacheVariables": {
        "LALVM_COVERAGE": "ON"
      }
    },
    {
      "name": "sanitizers",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build-san",
      "cacheVariables": {
        "LLVM_USE_SANITIZER": "Address;Undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers"
    }
  ]
}
