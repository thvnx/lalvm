# Doxyfile.in — Doxygen configuration for lalvm.
# CMake substitutes @VARIABLE@ placeholders via configure_file(@ONLY).

PROJECT_NAME     = "@PROJECT_NAME@"
PROJECT_BRIEF    = "Ada to LLVM IR compiler via MLIR"
OUTPUT_DIRECTORY = @PROJECT_BINARY_DIR@/docs
STRIP_FROM_PATH  = @PROJECT_SOURCE_DIR@ @PROJECT_BINARY_DIR@

# Sources: the README (rendered as the main page), the docs/ guides, public
# headers, implementation files, driver. AdaOps.md is the generated
# op-reference produced by mlir-tblgen.
INPUT         = @PROJECT_SOURCE_DIR@/README.md \
                @PROJECT_SOURCE_DIR@/docs \
                @PROJECT_SOURCE_DIR@/include \
                @PROJECT_SOURCE_DIR@/frontend \
                @PROJECT_SOURCE_DIR@/mlir \
                @PROJECT_SOURCE_DIR@/lalvm.cpp \
                @PROJECT_BINARY_DIR@/include/ada
RECURSIVE     = YES
FILE_PATTERNS = *.cpp *.h *.md *.inc

# Render the README as the documentation landing page.
USE_MDFILE_AS_MAINPAGE = @PROJECT_SOURCE_DIR@/README.md

# Generate GitHub-style header anchors so in-page links like [x](#documentation)
# resolve to `## Documentation` (Doxygen's default id scheme would not match).
MARKDOWN_ID_STYLE = GITHUB

EXTENSION_MAPPING = .inc=C++

PREDEFINED = GET_ATTRDEF_CLASSES GET_OP_CLASSES

# Link Ada RM references: @rm{5-1} renders as "RM 5-1" linking to AA-5-1.html.
# Dashes (not dots) because aliases do no text substitution on the slug.
ALIASES = "rm{1}=<a href=\"https://ada-rapporteur-group.github.io/ARM/Ada_202Y/AA-\1.html\">RM \1</a>"

# mlir-tblgen re-declares the `symbolizeEnum` template once per enum; doxygen
# cannot match the duplicate declarations. The filter drops the repeats (keeping
# the first), preserving the docs without an exclusion. See the script header.
FILTER_PATTERNS = "*/AdaOpsEnums.h.inc=awk -f @PROJECT_SOURCE_DIR@/docs/dedup-symbolize-enum.awk"

# Document all declarations, including private members and anonymous namespaces.
EXTRACT_ALL          = YES
EXTRACT_PRIVATE      = YES
EXTRACT_ANON_NSPACES = YES
EXTRACT_STATIC       = YES

# HTML output only; no LaTeX.
GENERATE_HTML  = YES
GENERATE_LATEX = NO

# Enable call/dependency graphs if Graphviz dot is available.
HAVE_DOT = @DOXYGEN_HAVE_DOT@

# Link documented entities to their source location.
SOURCE_BROWSER = YES

# Accept /// and /** as brief descriptions without an explicit @brief tag.
JAVADOC_AUTOBRIEF = YES

# Reduce noise.
QUIET = YES
