#!/usr/bin/env python3
"""Compile an Ada file with lalvm and link it using the GNAT runtime.

Usage: lalvm-make <file.adb>
The lalvm binary defaults to `lalvm` on PATH; override with LALVM=<path>.

Steps:
  1. gnatmake <file.adb>     build with GNAT to get a .ali (and discard .o)
  2. lalvm --emit=obj        recompile to .o using lalvm
  3. gnatbind -x <file.ali>  generate the Ada elaboration binder
  4. gnatlink <file.ali>     link against the GNAT runtime
"""

import os
import subprocess
import sys
from pathlib import Path


def run(*cmd: str) -> None:
    """Echo `cmd` to stderr, then run it, exiting with its status on failure."""
    print("+ " + " ".join(cmd), file=sys.stderr)
    result = subprocess.run(cmd)
    if result.returncode != 0:
        sys.exit(result.returncode)


def main() -> None:
    if len(sys.argv) != 2:
        print("Usage: lalvm-make <file.adb>", file=sys.stderr)
        sys.exit(1)

    adb = sys.argv[1]
    if not Path(adb).is_file():
        print(f"Error: file not found: {adb}", file=sys.stderr)
        sys.exit(1)

    lalvm = os.environ.get("LALVM", "lalvm")
    base = Path(adb).name.removesuffix(".adb")
    obj = f"{base}.o"
    ali = f"{base}.ali"

    # Step 1: compile with GNAT to produce the .ali file.
    run("gnatmake", "-q", "-f", adb)

    # Step 2: replace the .o with one produced by lalvm.
    os.replace(obj, f"{base}.gnat.o")
    run(lalvm, "--emit=obj", adb, "-o", obj)

    # Step 3: bind.
    run("gnatbind", "-x", ali)

    # Step 4: link.
    run("gnatlink", ali)


if __name__ == "__main__":
    main()
