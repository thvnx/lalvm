#!/usr/bin/env bash
# Merge the raw profiles from an instrumented `check-lalvm` run and render
# llvm-cov reports (terminal summary + HTML). Driven by the CMake target.
# Usage: coverage-report <llvm-profdata> <llvm-cov> <lalvm> <profile-dir> <out-dir> <src-dir> <gen-dir>

set -euo pipefail

run() { echo "+ $*" >&2; "$@"; }

if [[ $# -ne 7 ]]; then
  echo "Usage: coverage-report <llvm-profdata> <llvm-cov> <lalvm> <profile-dir> <out-dir> <src-dir> <gen-dir>" >&2
  exit 1
fi

LLVM_PROFDATA=$1
LLVM_COV=$2
LALVM=$3
PROFILE_DIR=$4
OUT_DIR=$5
SRC_DIR=$6
GEN_DIR=$7

shopt -s nullglob
PROFILES=("$PROFILE_DIR"/*.profraw)
if [[ ${#PROFILES[@]} -eq 0 ]]; then
  echo "Error: no .profraw files in $PROFILE_DIR; run the check-lalvm target first" >&2
  exit 1
fi

# Restrict reports to lalvm's hand-written sources and its tablegen-generated
# files in the build tree (else MLIR's own headers appear too). The two sets
# get separate summary tables and separate HTML reports.
SOURCES=("$SRC_DIR"/mlir "$SRC_DIR"/frontend "$SRC_DIR"/include "$SRC_DIR"/lalvm.cpp)

mkdir -p "$OUT_DIR"
PROFDATA="$OUT_DIR/lalvm.profdata"

run "$LLVM_PROFDATA" merge -sparse "${PROFILES[@]}" -o "$PROFDATA"
run "$LLVM_COV" show "$LALVM" -instr-profile="$PROFDATA" \
    -format=html -output-dir="$OUT_DIR/html" "${SOURCES[@]}"
run "$LLVM_COV" show "$LALVM" -instr-profile="$PROFDATA" \
    -format=html -output-dir="$OUT_DIR/html-generated" "$GEN_DIR"

echo "== lalvm sources =="
run "$LLVM_COV" report "$LALVM" -instr-profile="$PROFDATA" "${SOURCES[@]}"
echo
echo "== generated files (tablegen) =="
run "$LLVM_COV" report "$LALVM" -instr-profile="$PROFDATA" "$GEN_DIR"

echo "HTML reports: $OUT_DIR/html/index.html (sources)" >&2
echo "              $OUT_DIR/html-generated/index.html (generated)" >&2
