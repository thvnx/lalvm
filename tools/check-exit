import subprocess
import sys

if len(sys.argv) < 3:
    sys.exit("usage: check-exit COMMAND EXPECTED [ARGS...]")

expected = int(sys.argv[2])
actual = subprocess.run([sys.argv[1], *sys.argv[3:]]).returncode

if actual != expected:
    sys.exit(f"expected exit status {expected}, got {actual}")
